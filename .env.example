# Copy this file to .env and fill in local values.
# Never commit a real .env file. Never put live secrets in source control.

# Application
APP_NAME=AI Business Manager
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL / Supabase)
# Local:      postgresql+psycopg://postgres:postgres@localhost:5432/ai_business_manager
# Supabase:   postgresql+psycopg://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_business_manager

# Operational limits
MAX_AI_COST_USD_PER_RUN=5.00
MAX_BROWSER_PAGES_PER_RUN=20
MAX_SEARCHES_PER_RUN=30
MAX_EMAILS_PER_RUN=10
MAX_RETRIES=3
MAX_EXECUTION_TIME_SECONDS=300
MAX_TASKS_PER_RUN=50

# Integrations — declared for later phases. Phase 1 does not connect these services.
# Leave empty until the matching phase. Do not paste production keys into chat or logs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_SECONDS_BASE=1.0
OPENAI_RETRY_BACKOFF_SECONDS_MAX=30.0
OPENAI_PROMPT_TOKEN_COST_USD_PER_1K_TOKENS=0.00
OPENAI_COMPLETION_TOKEN_COST_USD_PER_1K_TOKENS=0.00
TAVILY_API_KEY=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
