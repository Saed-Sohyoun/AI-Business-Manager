# Application
APP_NAME=AI Business Operating System
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL — required for runtime persistence)
# Example: postgresql+psycopg://postgres:postgres@localhost:5432/ai_business_os
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_business_os
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=3

# CORS (comma-separated origins; empty = deny browser cross-origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Safety limits — Phase 22 Pilot Mode defaults
OPERATING_MODE=pilot
ALLOW_PRODUCTION_MODE=false
MAX_AGENT_RUNTIME_SECONDS=300
MAX_RETRIES=3
MAX_TASKS_PER_RUN=50
MAX_AI_COST_PER_RUN=5.00
DAILY_BUDGET_LIMIT=3.00
MAX_SINGLE_EXPENSE=20.00
MAX_COMPANIES_PER_DAY=20
MAX_AUDITS_PER_DAY=10
MAX_INITIAL_OUTREACH_PER_DAY=5
MAX_OUTBOUND_MESSAGES_PER_DAY=5
MAX_FOLLOWUPS=2
BUDGET_WARNING_RATIO=0.80
PILOT_CURRENCY=EUR
FOLLOWUP_DELAY_DAYS_FIRST=3
FOLLOWUP_DELAY_DAYS_SECOND=7
APPROVAL_REQUIRED_FOR_EXTERNAL_ACTIONS=true
APPROVAL_DEFAULT_TTL_SECONDS=86400
APPROVAL_AUTHORIZED_RESOLVERS=owner,admin

# Optional provider keys — NOT required for application startup
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3
# TAVILY_API_KEY=
TAVILY_TIMEOUT=30
TAVILY_MAX_RETRIES=3
TAVILY_MAX_RESULTS=10
TAVILY_SEARCH_DEPTH=basic
TAVILY_COST_PER_REQUEST=0.01

# Browser / Playwright — no API key; browsers optional at startup
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_JAVASCRIPT_ENABLED=false
BROWSER_TIMEOUT_SECONDS=30
BROWSER_NAVIGATION_TIMEOUT_SECONDS=20
BROWSER_MAX_PAGE_SIZE_BYTES=2000000
BROWSER_MAX_TEXT_CHARS=50000
BROWSER_MAX_LINKS=100
BROWSER_MAX_REDIRECTS=5
BROWSER_MAX_METADATA_ITEMS=40

# Research Agent
MAX_COMPANIES_PER_RUN=20
RESEARCH_SEARCH_RESULTS_PER_QUERY=10
RESEARCH_MAX_SEARCH_PAGES=2
RESEARCH_VERIFY_WITH_BROWSER=true
RESEARCH_BROWSER_TIMEOUT_SECONDS=20

# Audit Agent
MAX_AUDITS_PER_RUN=10
AUDIT_USE_AI=true
AUDIT_SEARCH_RESULTS=5

# Sales Agent (draft only — no Resend / no auto-send)
SALES_USE_AI=true
MAX_OUTREACHES_PER_RUN=10

# RESEND_API_KEY=
EMAIL_FROM=ops@example.com
RESEND_TIMEOUT=30
RESEND_MAX_RETRIES=3
RESEND_COST_PER_EMAIL=0.001
# STRIPE_SECRET_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=15
TELEGRAM_MAX_RETRIES=2
NOTIFICATION_MAX_PER_HOUR=12
NOTIFICATION_MAX_INFO_PER_DAY=3
NOTIFICATION_MIN_PRIORITY=important

# n8n orchestration (schedule/trigger only — business logic stays in backend)
# N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_HEADER=X-N8N-Webhook-Secret
N8N_WEBHOOK_REQUIRE_TIMESTAMP=true
N8N_WEBHOOK_MAX_SKEW_SECONDS=300
N8N_DEFAULT_TIMEOUT_SECONDS=120
N8N_MAX_EXECUTION_RETRIES=2
N8N_RATE_LIMIT_PER_MINUTE=30
API_RATE_LIMIT_PER_MINUTE=120
HEALTH_RATE_LIMIT_PER_MINUTE=60

# Owner HTTP actions (approve/dashboard APIs) — required for privileged routes
# OWNER_API_KEY=
